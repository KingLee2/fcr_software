<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">

    <!--Sequence name="NavigateWithoutReplanning"-->
    <PipelineSequence name="CoveragePipeline">
      <!-- Compute coverage path -->
      <ComputeCoveragePath 
          nav_path="{path}" 
          polygons="{field_polygon}" 
          polygons_frame_id="{polygon_frame_id}" 
          error_code_id="{compute_coverage_error_code}"/>

      <!-- Retry FollowPath 6 times -->
      <RecoveryNode number_of_retries="6" name="RetryFollowPath">

        <!-- Main -->
        <!-- <Sequence name="FollowPathSequence"> -->
          <FollowPath 
              path="{path}" 
              controller_id="FollowPath" 
              error_code_id="{follow_path_error_code}"/>
        <!-- </Sequence> -->

        <!-- Recovery -->
        <Sequence name="WaitBeforeRetry">
	        <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
          <Wait wait_duration="5.0"/>
          <!-- <BackUp backup_dist="0.20" backup_speed="0.1" error_code_id="{backup_code_id}"/> -->
          <!-- <Spin spin_dist="-0.26" error_code_id="{spin_error_code}"/> -->
        </Sequence>

      </RecoveryNode>

    <!-- </Sequence> -->
    </PipelineSequence>

  </BehaviorTree>
</root>
